# LiveAgent API-Zugangsdaten
# API-Key findest du in LiveAgent unter: Konfiguration -> System -> API -> Ihr API-Schluessel
LIVEAGENT_API_KEY=dein-api-key

# Nur die Subdomain + Domain, OHNE https:// und OHNE Pfad, z.B. "meinefirma.ladesk.com"
LIVEAGENT_DOMAIN=deinefirma.ladesk.com

# Optional: Port fuer den lokalen/remote HTTP-Server (Standard: 3000)
PORT=3000

# Optional: Wenn gesetzt, muss jede Anfrage den Header
#   Authorization: Bearer <MCP_SHARED_SECRET>
# mitschicken. Empfohlen, sobald der Server oeffentlich erreichbar ist
# (z.B. nach dem Deployment auf Railway/Render), damit nicht jeder mit der
# URL deinen LiveAgent-Account fernsteuern kann.
MCP_SHARED_SECRET=
